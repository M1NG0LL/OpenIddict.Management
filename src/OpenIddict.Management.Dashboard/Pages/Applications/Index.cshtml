@page
@model OpenIddict.Management.Dashboard.Pages.Applications.IndexModel
@{
    ViewData["Title"] = "Applications";
    var prefix = DashboardOptions.Value.PathPrefix.TrimEnd('/');
}

<div class="page-header">
    <div>
        <h1 class="page-title">Applications</h1>
        <p class="page-subtitle">Manage registered OAuth 2.0 / OpenID Connect client applications.</p>
    </div>
    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
        <button type="button" class="btn btn-secondary" onclick="openBulkStatusModal()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
            Bulk Status Management
        </button>
        <a href="@prefix/Applications/Create" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Create Application
        </a>
    </div>
</div>


<div class="card">
    <div class="card-body" style="padding: 0;">
        <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color);">
            <form method="get" class="filter-bar" style="margin-bottom: 0;">
                <div style="flex: 1; min-width: 200px;">
                    <input type="text" name="SearchTerm" id="search-input" class="form-control" placeholder="Search by Client ID or Display Name..." value="@Model.SearchTerm" />
                </div>
                <div style="width: 180px;">
                    <select name="Status" class="form-select" onchange="this.form.submit()">
                        <option value="">All Statuses</option>
                        @foreach (var status in Enum.GetValues<OpenIddict.Management.Enums.ApplicationStatus>())
                        {
                            <option value="@status" selected="@(Model.Status == status)">@status</option>
                        }
                    </select>
                </div>
                <div style="width: 180px;">
                    <select name="Environment" class="form-select" onchange="this.form.submit()">
                        <option value="">All Environments</option>
                        @foreach (var env in Enum.GetValues<OpenIddict.Management.Enums.ApplicationEnvironment>())
                        {
                            <option value="@env" selected="@(Model.Environment == env)">@env</option>
                        }
                    </select>
                </div>
            </form>
        </div>

        @if (Model.Applications.Items.Count == 0)
        {
            <div class="empty-state">
                <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
                <div class="empty-state-title">No applications found</div>
                <div class="empty-state-description">No registered OAuth 2.0 applications matched your search or filters. Create your first application to get started.</div>
                <a href="@prefix/Applications/Create" class="btn btn-primary">Create Application</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Application</th>
                            <th>Client ID</th>
                            <th>Environment</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th style="text-align: right; width: 80px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model.Applications.Items)
                        {
                            var initial = !string.IsNullOrWhiteSpace(app.DisplayName) 
                                ? app.DisplayName.Trim()[0].ToString().ToUpperInvariant() 
                                : (!string.IsNullOrWhiteSpace(app.ClientId) ? app.ClientId.Trim()[0].ToString().ToUpperInvariant() : "A");

                            <tr>
                                <td>
                                    <div class="app-identity-cell">
                                        <div class="app-avatar">@initial</div>
                                        <div>
                                            <a href="@prefix/Applications/Details?id=@app.Id" class="app-name" style="text-decoration: none;">@(string.IsNullOrWhiteSpace(app.DisplayName) ? app.ClientId : app.DisplayName)</a>
                                            <div style="display: flex; align-items: center; gap: 0.35rem; margin-top: 0.15rem; flex-wrap: wrap;">
                                                <span class="app-type-label">OAuth 2.0 Client</span>
                                                @foreach (var tag in app.Tags)
                                                {
                                                    <span class="badge badge-secondary" style="font-size: 0.7rem; padding: 0.1rem 0.35rem;">@tag</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.4rem;">
                                        <code>@app.ClientId</code>
                                        <button type="button" class="copy-btn" onclick="copyToClipboard('@app.ClientId', event)" title="Copy Client ID">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                        </button>
                                    </div>
                                </td>
                                <td><span class="badge badge-info">@app.Environment</span></td>
                                <td><partial name="_StatusBadge" model="app.Status" /></td>
                                <td><span style="color: var(--text-secondary); font-size: 0.85rem;">@app.CreatedAt.ToString("g")</span></td>
                                <td style="text-align: right;">
                                    <div class="action-dropdown">
                                        <button type="button" class="dropdown-trigger" aria-label="More actions">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="1"></circle>
                                                <circle cx="12" cy="5" r="1"></circle>
                                                <circle cx="12" cy="19" r="1"></circle>
                                            </svg>
                                        </button>
                                        <div class="dropdown-menu">
                                            <a href="@prefix/Applications/Details?id=@app.Id" class="dropdown-item">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                                <span>View Details</span>
                                            </a>
                                            <a href="@prefix/Applications/Edit?id=@app.Id" class="dropdown-item">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                                <span>Edit Application</span>
                                            </a>
                                            <button type="button" class="dropdown-item" onclick="openRotateSecretModal('@app.Id', '@app.ClientId')">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                                <span>Rotate Secret</span>
                                            </button>

                                            <div class="dropdown-divider"></div>

                                            @if (app.Status == OpenIddict.Management.Enums.ApplicationStatus.Active)
                                            {
                                                <form method="post" asp-page-handler="Deactivate" id="deactivate-form-@app.Id" style="display:block; margin:0;">
                                                    <input type="hidden" name="id" value="@app.Id" />
                                                    <button type="button" class="dropdown-item dropdown-item-warning" onclick="openConfirmModal('Deactivate Application', 'Deactivate application @app.ClientId? It will no longer be able to issue tokens.', () => document.getElementById('deactivate-form-@app.Id').submit())">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                                                        <span>Deactivate</span>
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="Delete" id="delete-form-@app.Id" style="display:block; margin:0;">
                                                    <input type="hidden" name="id" value="@app.Id" />
                                                    <input type="hidden" name="hardDelete" value="false" />
                                                    <button type="button" class="dropdown-item dropdown-item-danger" onclick="openConfirmModal('Delete Application', 'Mark application @app.ClientId as deleted?', () => document.getElementById('delete-form-@app.Id').submit())">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                        <span>Delete</span>
                                                    </button>
                                                </form>
                                            }
                                            else if (app.Status == OpenIddict.Management.Enums.ApplicationStatus.Disabled)
                                            {
                                                <form method="post" asp-page-handler="Activate" id="activate-form-@app.Id" style="display:block; margin:0;">
                                                    <input type="hidden" name="id" value="@app.Id" />
                                                    <button type="button" class="dropdown-item dropdown-item-success" onclick="openConfirmModal('Reactivate Application', 'Re-activate application @app.ClientId?', () => document.getElementById('activate-form-@app.Id').submit())">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                                        <span>Activate</span>
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="Delete" id="delete-form-@app.Id" style="display:block; margin:0;">
                                                    <input type="hidden" name="id" value="@app.Id" />
                                                    <input type="hidden" name="hardDelete" value="false" />
                                                    <button type="button" class="dropdown-item dropdown-item-danger" onclick="openConfirmModal('Delete Application', 'Mark application @app.ClientId as deleted?', () => document.getElementById('delete-form-@app.Id').submit())">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                        <span>Delete</span>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="Activate" id="restore-form-@app.Id" style="display:block; margin:0;">
                                                    <input type="hidden" name="id" value="@app.Id" />
                                                    <button type="button" class="dropdown-item dropdown-item-success" onclick="openConfirmModal('Restore Application', 'Restore deleted application @app.ClientId to Active status?', () => document.getElementById('restore-form-@app.Id').submit())">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                                        <span>Restore</span>
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="Delete" id="delete-form-@app.Id" style="display:block; margin:0;">
                                                    <input type="hidden" name="id" value="@app.Id" />
                                                    <input type="hidden" name="hardDelete" value="true" />
                                                    <button type="button" class="dropdown-item dropdown-item-danger" onclick="openConfirmModal('Permanently Delete Application', 'Permanently delete application @app.ClientId? This cannot be undone.', () => document.getElementById('delete-form-@app.Id').submit())">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                        <span>Permanently Delete</span>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Applications.TotalCount > 0)
            {
                <partial name="_Pagination" model="Model.Applications" />
            }
        }
    </div>
</div>

<!-- Bulk Status Management Modal Popup -->
<div id="bulk-status-modal" class="modal-backdrop" onclick="closeBulkStatusModal()">
    <div class="modal" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span>Bulk Status Management</span>
            <button type="button" class="btn btn-secondary btn-sm" onclick="closeBulkStatusModal()" style="padding: 0.2rem 0.45rem;">✕</button>
        </div>
        <form method="post" asp-page-handler="BulkStatus" id="bulk-status-form">
            <div class="modal-body">
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.5;">
                    Batch update the operational status for all applications assigned to a target environment or across the entire system.
                </p>

                <div class="form-group">
                    <label class="form-label">Target Environment</label>
                    <select name="bulkEnvironment" class="form-select">
                        <option value="">All Environments</option>
                        @foreach (var env in Enum.GetValues<OpenIddict.Management.Enums.ApplicationEnvironment>())
                        {
                            <option value="@env">@env</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Target Operational Status</label>
                    <select name="bulkStatus" class="form-select">
                        <option value="Active">Active</option>
                        <option value="Disabled">Disabled</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeBulkStatusModal()">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="openConfirmModal('Apply Bulk Status', 'Are you sure you want to update all applications in the selected environment?', () => document.getElementById('bulk-status-form').submit())">
                    Apply to Environment
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Standalone Rotate Secret Modal -->
<div id="rotate-secret-backdrop" class="modal-backdrop" onclick="closeRotateSecretModal()">
    <div class="modal" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span>Rotate Client Secret</span>
            <button type="button" class="btn btn-secondary btn-sm" onclick="closeRotateSecretModal()" style="padding: 0.2rem 0.45rem;">✕</button>
        </div>
        <form method="post" asp-page-handler="UpdateSecret">
            <div class="modal-body">
                <input type="hidden" name="id" id="rotate-secret-app-id" />
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.5;">
                    Generate or specify a new client secret for <strong id="rotate-secret-client-name" style="color: var(--text-primary);"></strong>. Once saved, old credentials are invalidated.
                </p>

                <div class="form-group">
                    <label class="form-label" for="rotate-secret-input">New Client Secret</label>
                    <div style="display: flex; gap: 0.5rem;">
                        <input type="text" name="newSecret" id="rotate-secret-input" class="form-control" placeholder="Enter or generate secret..." data-btn-target="rotate-secret-submit-btn" required />
                        <button type="button" class="btn btn-secondary" onclick="generateClientSecret('rotate-secret-input')">Generate</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeRotateSecretModal()">Cancel</button>
                <button type="submit" id="rotate-secret-submit-btn" class="btn btn-primary" disabled>Save New Secret</button>
            </div>
        </form>
    </div>
</div>
