@page
@model OpenIddict.Management.Dashboard.Pages.Scopes.IndexModel
@{
    ViewData["Title"] = "Scope Manager";
    var prefix = DashboardOptions.Value.PathPrefix.TrimEnd('/');
}

<div class="page-header">
    <div>
        <h1 class="page-title">Scope Manager</h1>
        <p class="page-subtitle">Configure OpenID Connect resources and custom authorization scopes.</p>
    </div>
    <div>
        <a href="@prefix/Scopes/Edit" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Create Scope
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body" style="padding: 0;">
        <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-color);">
            <form method="get" class="filter-bar" style="margin-bottom: 0;">
                <div style="flex: 1; min-width: 200px;">
                    <input type="text" name="SearchTerm" id="search-input" class="form-control" placeholder="Search scopes by name..." value="@Model.SearchTerm" />
                </div>
                <button type="submit" class="btn btn-secondary">Search</button>
            </form>
        </div>

        @if (Model.Scopes.Items.Count == 0)
        {
            <div class="empty-state">
                <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <div class="empty-state-title">No scopes configured</div>
                <div class="empty-state-description">Define OAuth 2.0 / OpenID Connect scopes to control client access permissions and resources.</div>
                <a href="@prefix/Scopes/Edit" class="btn btn-primary">Create Scope</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Scope Name</th>
                            <th>Display Name</th>
                            <th>Description</th>
                            <th>Resources</th>
                            <th style="text-align: right; width: 80px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var scope in Model.Scopes.Items)
                        {
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 0.6rem;">
                                        <div style="width: 28px; height: 28px; border-radius: 6px; background-color: var(--accent-light); color: var(--accent-primary); display: flex; align-items: center; justify-content: center;">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                            </svg>
                                        </div>
                                        <div>
                                            <strong>@scope.Name</strong>
                                        </div>
                                    </div>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(scope.DisplayName) ? "-" : scope.DisplayName)</td>
                                <td><span style="color: var(--text-secondary); font-size: 0.85rem;">@(string.IsNullOrWhiteSpace(scope.Description) ? "No description provided." : scope.Description)</span></td>
                                <td>
                                    @if (scope.Resources != null && scope.Resources.Any())
                                    {
                                        <div style="display: flex; gap: 0.35rem; flex-wrap: wrap;">
                                            @foreach (var resource in scope.Resources)
                                            {
                                                <span class="badge badge-secondary" style="font-size: 0.75rem;">@resource</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span style="color: var(--text-muted);">-</span>
                                    }
                                </td>
                                <td style="text-align: right;">
                                    <div class="action-dropdown">
                                        <button type="button" class="dropdown-trigger" aria-label="More actions">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <circle cx="12" cy="12" r="1"></circle>
                                                <circle cx="12" cy="5" r="1"></circle>
                                                <circle cx="12" cy="19" r="1"></circle>
                                            </svg>
                                        </button>
                                        <div class="dropdown-menu">
                                            <a href="@prefix/Scopes/Edit?id=@scope.Id" class="dropdown-item">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                                <span>Edit Scope</span>
                                            </a>
                                            <div class="dropdown-divider"></div>
                                            <form method="post" asp-page-handler="Delete" id="delete-scope-@scope.Id" style="display:block; margin:0;">
                                                <input type="hidden" name="id" value="@scope.Id" />
                                                <button type="button" class="dropdown-item dropdown-item-danger" onclick="openConfirmModal('Delete Scope', 'Are you sure you want to delete scope @scope.Name?', () => document.getElementById('delete-scope-@scope.Id').submit())">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                    <span>Delete</span>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Scopes.TotalCount > 0)
            {
                <partial name="_Pagination" model="Model.Scopes" />
            }
        }
    </div>
</div>
