@page
@model OpenIddict.Management.Dashboard.Pages.Tokens.IndexModel
@{
    ViewData["Title"] = "Token & Session Inspector";
    var prefix = DashboardOptions.Value.PathPrefix.TrimEnd('/');
    
    int activeTokenFilterCount = 0;
    if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) activeTokenFilterCount++;
    if (!string.IsNullOrWhiteSpace(Model.UserId)) activeTokenFilterCount++;
    if (!string.IsNullOrWhiteSpace(Model.ClientId)) activeTokenFilterCount++;
    if (!string.IsNullOrWhiteSpace(Model.AuthorizationId)) activeTokenFilterCount++;
    if (Model.CreatedFrom.HasValue) activeTokenFilterCount++;
    if (Model.CreatedTo.HasValue) activeTokenFilterCount++;
    if (!string.IsNullOrWhiteSpace(Model.Status)) activeTokenFilterCount++;
    if (!string.IsNullOrWhiteSpace(Model.TokenType)) activeTokenFilterCount++;

    bool hasActiveTokenFilters = activeTokenFilterCount > 0;

    int activeSessionFilterCount = 0;
    if (!string.IsNullOrWhiteSpace(Model.SessionSearchTerm)) activeSessionFilterCount++;
    if (!string.IsNullOrWhiteSpace(Model.SessionUserId)) activeSessionFilterCount++;
    if (!string.IsNullOrWhiteSpace(Model.SessionClientId)) activeSessionFilterCount++;
    if (!string.IsNullOrWhiteSpace(Model.SessionStatus)) activeSessionFilterCount++;

    bool hasActiveSessionFilters = activeSessionFilterCount > 0;

    string isTokensActive = Model.ActiveTab == "sessions" ? "" : "active";
    string isSessionsActive = Model.ActiveTab == "sessions" ? "active" : "";

    string FormatExpiry(DateTimeOffset? expiry)
    {
        if (!expiry.HasValue) return "Never";
        var now = DateTimeOffset.UtcNow;
        var diff = expiry.Value - now;
        if (diff.TotalSeconds <= 0)
        {
            var ago = now - expiry.Value;
            if (ago.TotalDays >= 1) return $"Expired {(int)ago.TotalDays}d ago";
            if (ago.TotalHours >= 1) return $"Expired {(int)ago.TotalHours}h ago";
            return $"Expired {(int)ago.TotalMinutes}m ago";
        }
        if (diff.TotalDays >= 1) return $"in {(int)diff.TotalDays}d {(int)diff.Hours}h";
        if (diff.TotalHours >= 1) return $"in {(int)diff.TotalHours}h {(int)diff.Minutes}m";
        return $"in {(int)diff.TotalMinutes}m";
    }

    string GetTokenTypeBadge(string? type) => type?.ToLowerInvariant() switch
    {
        "access_token" => "token-badge-access",
        "refresh_token" => "token-badge-refresh",
        "authorization_code" => "token-badge-authcode",
        "device_code" => "token-badge-device",
        _ => "badge-secondary"
    };
}

<div class="page-header">
    <div>
        <h1 class="page-title">Token & Session Inspector</h1>
        <p class="page-subtitle">Token Inspector & Revocation: Inspect, analyze, and manage tokens and active sessions with multi-criteria filtering and diagnostics.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="server-toast-data" data-message="@Model.Message" data-type="@(Model.IsSuccess ? "success" : "danger")" data-title="@(Model.IsSuccess ? "Success!" : "Revocation Failed")" style="display:none;"></div>
}

<!-- Analytics Section Above Tabs -->
<div class="analytics-section" style="margin-bottom: 1.75rem;">
    <div class="section-title-group" style="margin-bottom: 1rem;">
        <h2 class="section-title" style="font-size: 1.15rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: -2px; margin-right: 0.35rem; color: var(--accent-primary, #6366f1);">
                <path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path>
                <path d="M22 12A10 10 0 0 0 12 2v10z"></path>
            </svg>
            Analytics &amp; Token Activity
        </h2>
    </div>

    <div class="chart-grid">
        <div class="chart-card">
            <div class="chart-canvas-container" style="height: 260px;">
                <canvas id="tokensAppsChart"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <div class="chart-canvas-container" style="height: 260px;">
                <canvas id="tokensBreakdownChart"></canvas>
            </div>
        </div>
    </div>

    <div class="chart-card chart-card-full" style="margin-top: 1.25rem;">
        <div style="display: flex; justify-content: flex-end; margin-bottom: 0.5rem;">
            <select id="tokens-timeline-range" class="form-select form-select-sm" style="width: auto; padding: 0.25rem 0.65rem; font-size: 0.8rem;" onchange="onTokensTimelineRangeChange(this.value)">
                <option value="7">Last 7 days</option>
                <option value="14">Last 14 days</option>
                <option value="30" selected>Last 30 days</option>
                <option value="60">Last 60 days</option>
                <option value="90">Last 90 days</option>
            </select>
        </div>
        <div class="chart-canvas-container" style="position: relative; height: 230px;">
            <canvas id="tokensTimelineChart"></canvas>
        </div>
    </div>
</div>

<!-- Summary Metrics Cards -->
<div class="metrics-grid" style="margin-bottom: 1.5rem;">
    <div class="metric-card metric-tokens">
        <div class="metric-icon-wrapper">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
            </svg>
        </div>
        <div>
            <div class="metric-value">@Model.TokenCounts.Total</div>
            <div class="metric-label">All Tokens</div>
        </div>
    </div>

    <div class="metric-card metric-apps">
        <div class="metric-icon-wrapper" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>
        <div>
            <div class="metric-value" style="color: var(--success-color, #10b981);">@Model.TokenCounts.Valid</div>
            <div class="metric-label">Valid Tokens</div>
        </div>
    </div>

    <div class="metric-card metric-scopes">
        <div class="metric-icon-wrapper" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
        </div>
        <div>
            <div class="metric-value" style="color: var(--warning-color, #f59e0b);">@Model.TokenCounts.Expired</div>
            <div class="metric-label">Expired Tokens</div>
        </div>
    </div>

    <div class="metric-card metric-sessions">
        <div class="metric-icon-wrapper" style="background: rgba(239, 68, 68, 0.15); color: #ef4444;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="15" y1="9" x2="9" y2="15"></line>
                <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
        </div>
        <div>
            <div class="metric-value" style="color: var(--danger-color, #ef4444);">@Model.TokenCounts.Revoked</div>
            <div class="metric-label">Revoked Tokens</div>
        </div>
    </div>
</div>

<!-- Tab Navigation Bar -->
<div class="tab-bar">
    <button type="button" class="tab-btn @isTokensActive" id="tab-btn-tokens" onclick="switchInspectorTab('tokens')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
        <span>Tokens</span>
        <span class="tab-badge">@Model.Tokens.TotalCount</span>
    </button>
    <button type="button" class="tab-btn @isSessionsActive" id="tab-btn-sessions" onclick="switchInspectorTab('sessions')">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        <span>Sessions &amp; Authorizations</span>
        <span class="tab-badge">@Model.Sessions.TotalCount</span>
    </button>
</div>

<!-- ============================================== -->
<!-- TAB PANEL 1: TOKENS                            -->
<!-- ============================================== -->
<div id="tab-panel-tokens" class="tab-panel @isTokensActive">
    <div class="card" style="margin-bottom: 1.5rem;">
        <div style="padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 0.85rem; flex-wrap: wrap;">
            <form method="get" style="display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 240px; margin-bottom: 0;">
                <input type="hidden" name="activeTab" value="tokens" />
                @if (!string.IsNullOrWhiteSpace(Model.ClientId)) { <input type="hidden" name="ClientId" value="@Model.ClientId" /> }
                @if (!string.IsNullOrWhiteSpace(Model.UserId)) { <input type="hidden" name="UserId" value="@Model.UserId" /> }
                @if (!string.IsNullOrWhiteSpace(Model.AuthorizationId)) { <input type="hidden" name="AuthorizationId" value="@Model.AuthorizationId" /> }
                @if (!string.IsNullOrWhiteSpace(Model.Status)) { <input type="hidden" name="Status" value="@Model.Status" /> }
                @if (!string.IsNullOrWhiteSpace(Model.TokenType)) { <input type="hidden" name="TokenType" value="@Model.TokenType" /> }
                @if (Model.CreatedFrom.HasValue) { <input type="hidden" name="CreatedFrom" value="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" /> }
                @if (Model.CreatedTo.HasValue) { <input type="hidden" name="CreatedTo" value="@Model.CreatedTo?.ToString("yyyy-MM-dd")" /> }

                <div style="position: relative; flex: 1;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="search-term" name="SearchTerm" class="form-control" style="padding-left: 2.35rem;" placeholder="Search tokens by ID, subject, client..." value="@Model.SearchTerm" />
                </div>
                <button type="submit" class="btn btn-secondary" style="height: 38px;">Search</button>
            </form>

            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                <!-- Circular Filter Trigger Button (Settings / Sliders Icon) -->
                <button type="button" 
                        class="filter-trigger-btn @(hasActiveTokenFilters ? "has-filters" : "")" 
                        id="tokens-filter-trigger-btn"
                        data-target="tokens-filter-drawer"
                        onclick="openFilterDrawer('tokens-filter-drawer')" 
                        aria-label="Open token filter properties"
                        aria-controls="tokens-filter-drawer"
                        title="Filter tokens">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="6" x2="20" y2="6"></line>
                        <circle cx="8" cy="6" r="2.5" fill="currentColor"></circle>
                        <line x1="4" y1="12" x2="20" y2="12"></line>
                        <circle cx="16" cy="12" r="2.5" fill="currentColor"></circle>
                        <line x1="4" y1="18" x2="20" y2="18"></line>
                        <circle cx="10" cy="18" r="2.5" fill="currentColor"></circle>
                    </svg>
                    @if (hasActiveTokenFilters)
                    {
                        <span class="filter-badge">@activeTokenFilterCount</span>
                    }
                </button>

                <button type="button" class="btn btn-secondary" onclick="openModal('modal-revoke-user')">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    Revoke User Tokens
                </button>
                <button type="button" class="btn btn-secondary" onclick="openModal('modal-revoke-client')">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                    Revoke Client Tokens
                </button>
                <button type="button" class="btn btn-secondary" onclick="openModal('modal-revoke-user-sessions')">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    Revoke User Sessions
                </button>
                <form method="post" asp-page-handler="RevokeFiltered" id="revoke-filtered-form" style="display:inline; margin:0;">
                    <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                    <input type="hidden" name="UserId" value="@Model.UserId" />
                    <input type="hidden" name="ClientId" value="@Model.ClientId" />
                    <input type="hidden" name="AuthorizationId" value="@Model.AuthorizationId" />
                    <input type="hidden" name="CreatedFrom" value="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="CreatedTo" value="@Model.CreatedTo?.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="Status" value="@Model.Status" />
                    <input type="hidden" name="TokenType" value="@Model.TokenType" />
                    <button type="button" class="btn btn-danger" onclick="openConfirmModal('Revoke Filtered Tokens', 'Revoke ALL tokens matching the currently applied filters? This will immediately invalidate access for those tokens.', () => document.getElementById('revoke-filtered-form').submit())">
                        Revoke Filtered Tokens
                    </button>
                </form>
            </div>
        </div>

        @if (hasActiveTokenFilters)
        {
            <div class="active-filters-bar">
                <span class="active-filters-label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
                    Active filters:
                </span>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <span class="active-filter-pill"><strong>Search:</strong> @Model.SearchTerm</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ClientId))
                {
                    <span class="active-filter-pill"><strong>Client:</strong> @Model.ClientId</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.UserId))
                {
                    <span class="active-filter-pill"><strong>Subject:</strong> @Model.UserId</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.AuthorizationId))
                {
                    <span class="active-filter-pill"><strong>Authorization:</strong> @Model.AuthorizationId</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Status))
                {
                    <span class="active-filter-pill"><strong>Status:</strong> @Model.Status</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.TokenType))
                {
                    <span class="active-filter-pill"><strong>Type:</strong> @Model.TokenType</span>
                }
                @if (Model.CreatedFrom.HasValue)
                {
                    <span class="active-filter-pill"><strong>From:</strong> @Model.CreatedFrom?.ToString("yyyy-MM-dd")</span>
                }
                @if (Model.CreatedTo.HasValue)
                {
                    <span class="active-filter-pill"><strong>To:</strong> @Model.CreatedTo?.ToString("yyyy-MM-dd")</span>
                }
                <a href="@prefix/Tokens?activeTab=tokens" class="clear-all-filters-btn">Clear all</a>
            </div>
        }
    </div>

    <!-- Token Records Table -->
    <div class="card">
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Token ID / Ref</th>
                            <th>Client Application</th>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Expires</th>
                            <th>Serialized Data</th>
                            <th style="text-align: right; width: 80px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Tokens.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="9">
                                    <div class="empty-state">
                                        <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
                                        </svg>
                                        <div class="empty-state-title">No tokens found</div>
                                        <div class="empty-state-description">No tokens match the selected filters. Try broadening your criteria.</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var token in Model.Tokens.Items)
                            {
                                var expiryText = FormatExpiry(token.ExpirationDate);
                                var typeBadge = GetTokenTypeBadge(token.Type);
                                var displayId = token.Id.Length > 8 ? token.Id[..8] + "..." : token.Id;

                                <tr data-serialized="@token.SerializedData">
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 0.35rem;">
                                            <code title="@token.Id" style="font-weight: 600;">@displayId</code>
                                            <button type="button" class="copy-btn" data-copy="@token.Id" onclick="copyToClipboard(this.getAttribute('data-copy'), event)" title="Copy Token ID">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                            </button>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(token.ReferenceId))
                                        {
                                            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.15rem;">
                                                Ref: @(token.ReferenceId.Length > 10 ? token.ReferenceId[..10] + "..." : token.ReferenceId)
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div>
                                            <span style="font-weight: 500;">@(string.IsNullOrWhiteSpace(token.ClientDisplayName) ? (token.ClientId ?? "Unknown") : token.ClientDisplayName)</span>
                                            @if (!string.IsNullOrWhiteSpace(token.ClientId) && !string.IsNullOrWhiteSpace(token.ClientDisplayName))
                                            {
                                                <div style="font-size: 0.75rem; color: var(--text-muted);">@token.ClientId</div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(token.Subject))
                                        {
                                            <span title="@token.Subject" style="font-size: 0.85rem;">@(token.Subject.Length > 16 ? token.Subject[..16] + "..." : token.Subject)</span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted); font-size: 0.85rem;">(client_credentials)</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @typeBadge">@(token.Type ?? "unknown")</span>
                                    </td>
                                    <td>
                                        @if (token.IsRevoked)
                                        {
                                            <span class="badge badge-danger">
                                                <span class="status-dot status-dot-danger"></span>
                                                <span>Revoked</span>
                                            </span>
                                        }
                                        else if (token.IsExpired)
                                        {
                                            <span class="badge badge-warning">
                                                <span class="status-dot status-dot-warning"></span>
                                                <span>Expired</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">
                                                <span class="status-dot status-dot-active"></span>
                                                <span>Valid</span>
                                            </span>
                                        }
                                    </td>
                                    <td><span style="color: var(--text-secondary); font-size: 0.85rem;">@(token.CreatedAt?.ToString("g") ?? "-")</span></td>
                                    <td>
                                        <span title="@(token.ExpirationDate?.ToString("g") ?? "Never")" style="font-size: 0.85rem;">@expiryText</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(token.SerializedData))
                                        {
                                            var displayData = token.SerializedData.Length > 20
                                                ? token.SerializedData[..20] + "..."
                                                : token.SerializedData;
                                            <div style="display: flex; align-items: center; gap: 0.35rem;" title="@token.SerializedData">
                                                <code style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: inline-block;">@displayData</code>
                                                <button type="button" class="copy-btn" data-copy="@token.SerializedData" onclick="copyToClipboard(this.getAttribute('data-copy'), event)" title="Copy Serialized Data">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted);">-</span>
                                        }
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="action-dropdown">
                                            <button type="button" class="dropdown-trigger" aria-label="More actions" onclick="toggleDropdown(this, event)">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="12" cy="12" r="1"></circle>
                                                    <circle cx="12" cy="5" r="1"></circle>
                                                    <circle cx="12" cy="19" r="1"></circle>
                                                </svg>
                                            </button>
                                            <div class="dropdown-menu">
                                                <button type="button" class="dropdown-item" onclick="openTokenDrawer({ id: '@token.Id', refId: '@(token.ReferenceId ?? "")', clientId: '@(token.ClientId ?? "")', clientName: '@(token.ClientDisplayName ?? "")', subject: '@(token.Subject ?? "")', type: '@(token.Type ?? "")', isRevoked: @(token.IsRevoked.ToString().ToLowerInvariant()), isExpired: @(token.IsExpired.ToString().ToLowerInvariant()), created: '@(token.CreatedAt?.ToString("u") ?? "")', expires: '@(token.ExpirationDate?.ToString("u") ?? "")', revokedAt: '@(token.RevokedAt?.ToString("u") ?? "")', serializedData: this.closest('tr').getAttribute('data-serialized') })">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                                    <span>Inspect Payload</span>
                                                </button>
                                                <button type="button" class="dropdown-item" onclick="copyToClipboard('@token.Id', event)">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                                    <span>Copy Token ID</span>
                                                </button>
                                                @if (!token.IsRevoked)
                                                {
                                                    <div class="dropdown-divider"></div>
                                                    <form method="post" asp-page-handler="RevokeSingle" id="revoke-token-@token.Id" style="display:block; margin:0;">
                                                        <input type="hidden" name="tokenId" value="@token.Id" />
                                                        <input type="hidden" name="activeTab" value="tokens" />
                                                        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                                        <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                                        <input type="hidden" name="userId" value="@Model.UserId" />
                                                        <input type="hidden" name="clientId" value="@Model.ClientId" />
                                                        <input type="hidden" name="authorizationId" value="@Model.AuthorizationId" />
                                                        <input type="hidden" name="createdFrom" value="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" />
                                                        <input type="hidden" name="createdTo" value="@Model.CreatedTo?.ToString("yyyy-MM-dd")" />
                                                        <input type="hidden" name="status" value="@Model.Status" />
                                                        <input type="hidden" name="tokenType" value="@Model.TokenType" />
                                                        <button type="button" class="dropdown-item dropdown-item-danger" onclick="openConfirmModal('Revoke Token', 'Are you sure you want to revoke this token immediately?', () => document.getElementById('revoke-token-@token.Id').submit())">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line></svg>
                                                            <span>Revoke Token</span>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Tokens.TotalCount > 0)
            {
                ViewData["PageParamName"] = "pageNumber";
                <partial name="_Pagination" model="Model.Tokens" view-data="ViewData" />
            }
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- TAB PANEL 2: SESSIONS                          -->
<!-- ============================================== -->
<div id="tab-panel-sessions" class="tab-panel @isSessionsActive">
    <div class="card" style="margin-bottom: 1.5rem;">
        <div style="padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 0.85rem; flex-wrap: wrap;">
            <form method="get" style="display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 240px; margin-bottom: 0;">
                <input type="hidden" name="activeTab" value="sessions" />
                @if (!string.IsNullOrWhiteSpace(Model.SessionUserId)) { <input type="hidden" name="SessionUserId" value="@Model.SessionUserId" /> }
                @if (!string.IsNullOrWhiteSpace(Model.SessionClientId)) { <input type="hidden" name="SessionClientId" value="@Model.SessionClientId" /> }
                @if (!string.IsNullOrWhiteSpace(Model.SessionStatus)) { <input type="hidden" name="SessionStatus" value="@Model.SessionStatus" /> }

                <div style="position: relative; flex: 1;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none;">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="session-search-term" name="SessionSearchTerm" class="form-control" style="padding-left: 2.35rem;" placeholder="Search sessions by Auth ID, user, client..." value="@Model.SessionSearchTerm" />
                </div>
                <button type="submit" class="btn btn-secondary" style="height: 38px;">Search</button>
            </form>

            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <!-- Circular Filter Trigger Button (Settings / Sliders Icon) -->
                <button type="button" 
                        class="filter-trigger-btn @(hasActiveSessionFilters ? "has-filters" : "")" 
                        id="sessions-filter-trigger-btn"
                        data-target="sessions-filter-drawer"
                        onclick="openFilterDrawer('sessions-filter-drawer')" 
                        aria-label="Open session filter properties"
                        aria-controls="sessions-filter-drawer"
                        title="Filter sessions">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="4" y1="6" x2="20" y2="6"></line>
                        <circle cx="8" cy="6" r="2.5" fill="currentColor"></circle>
                        <line x1="4" y1="12" x2="20" y2="12"></line>
                        <circle cx="16" cy="12" r="2.5" fill="currentColor"></circle>
                        <line x1="4" y1="18" x2="20" y2="18"></line>
                        <circle cx="10" cy="18" r="2.5" fill="currentColor"></circle>
                    </svg>
                    @if (hasActiveSessionFilters)
                    {
                        <span class="filter-badge">@activeSessionFilterCount</span>
                    }
                </button>
            </div>
        </div>

        @if (hasActiveSessionFilters)
        {
            <div class="active-filters-bar">
                <span class="active-filters-label">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
                    Active filters:
                </span>
                @if (!string.IsNullOrWhiteSpace(Model.SessionSearchTerm))
                {
                    <span class="active-filter-pill"><strong>Search:</strong> @Model.SessionSearchTerm</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SessionUserId))
                {
                    <span class="active-filter-pill"><strong>Subject:</strong> @Model.SessionUserId</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SessionClientId))
                {
                    <span class="active-filter-pill"><strong>Client:</strong> @Model.SessionClientId</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SessionStatus))
                {
                    <span class="active-filter-pill"><strong>Status:</strong> @Model.SessionStatus</span>
                }
                <a href="@prefix/Tokens?activeTab=sessions" class="clear-all-filters-btn">Clear all</a>
            </div>
        }
    </div>

    <!-- Sessions Table -->
    <div class="card">
        <div class="card-body" style="padding: 0;">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Authorization ID</th>
                            <th>User (Subject)</th>
                            <th>Client Application</th>
                            <th>Status</th>
                            <th>Granted Scopes</th>
                            <th>Created</th>
                            <th>Last Modified</th>
                            <th>Tokens</th>
                            <th style="text-align: right; width: 80px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Sessions.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="9">
                                    <div class="empty-state">
                                        <svg class="empty-state-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="9" cy="7" r="4"></circle>
                                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                        </svg>
                                        <div class="empty-state-title">No sessions found</div>
                                        <div class="empty-state-description">No authorization sessions matched the filter criteria.</div>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var session in Model.Sessions.Items)
                            {
                                var displayAuthId = session.Id.Length > 8 ? session.Id[..8] + "..." : session.Id;
                                <tr>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 0.35rem;">
                                            <code title="@session.Id" style="font-weight: 600;">@displayAuthId</code>
                                            <button type="button" class="copy-btn" data-copy="@session.Id" onclick="copyToClipboard(this.getAttribute('data-copy'), event)" title="Copy Authorization ID">
                                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(session.Subject))
                                        {
                                            <span title="@session.Subject" style="font-weight: 500;">@session.Subject</span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted);">(none)</span>
                                        }
                                    </td>
                                    <td>
                                        <div>
                                            <span style="font-weight: 500;">@(string.IsNullOrWhiteSpace(session.ClientDisplayName) ? (session.ClientId ?? "Unknown") : session.ClientDisplayName)</span>
                                            @if (!string.IsNullOrWhiteSpace(session.ClientId) && !string.IsNullOrWhiteSpace(session.ClientDisplayName))
                                            {
                                                <div style="font-size: 0.75rem; color: var(--text-muted);">@session.ClientId</div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (session.IsRevoked)
                                        {
                                            <span class="badge badge-danger">
                                                <span class="status-dot status-dot-danger"></span>
                                                <span>Revoked</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">
                                                <span class="status-dot status-dot-active"></span>
                                                <span>Active</span>
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(session.Scopes))
                                        {
                                            var scopeList = session.Scopes.Split([' ', ',', '[', ']', '"'], StringSplitOptions.RemoveEmptyEntries);
                                            <div style="display: flex; gap: 0.25rem; flex-wrap: wrap; max-width: 180px;">
                                                @foreach (var sc in scopeList.Take(3))
                                                {
                                                    <span class="badge badge-secondary" style="font-size: 0.7rem; padding: 0.1rem 0.35rem;">@sc</span>
                                                }
                                                @if (scopeList.Length > 3)
                                                {
                                                    <span class="badge badge-secondary" style="font-size: 0.7rem; padding: 0.1rem 0.35rem;" title="@session.Scopes">+@(scopeList.Length - 3)</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted);">-</span>
                                        }
                                    </td>
                                    <td><span style="color: var(--text-secondary); font-size: 0.85rem;">@session.CreatedAt.ToString("g")</span></td>
                                    <td><span style="color: var(--text-secondary); font-size: 0.85rem;">@(session.LastModifiedAt?.ToString("g") ?? "-")</span></td>
                                    <td>
                                        <a href="@prefix/Tokens?activeTab=tokens&authorizationId=@session.Id" class="badge badge-secondary" title="Filter tokens by authorization session @session.Id" style="text-decoration: none;">
                                            @session.TokenCount token@(session.TokenCount == 1 ? "" : "s")
                                        </a>
                                    </td>
                                    <td style="text-align: right;">
                                        @if (!session.IsRevoked)
                                        {
                                            <form method="post" asp-page-handler="RevokeSession" id="revoke-session-@session.Id" style="display:inline; margin:0;">
                                                <input type="hidden" name="authorizationId" value="@session.Id" />
                                                <input type="hidden" name="activeTab" value="sessions" />
                                                <button type="button" class="btn btn-secondary btn-sm" style="color: var(--danger-color, #ef4444); border-color: rgba(239, 68, 68, 0.3);" onclick="openConfirmModal('Revoke Session', 'Revoke authorization session for @(session.Subject ?? session.ClientId)? All associated active tokens will be revoked immediately.', () => document.getElementById('revoke-session-@session.Id').submit())" title="Revoke Session">
                                                    Revoke
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span style="color: var(--text-muted); font-size: 0.8rem;">Revoked</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Sessions.TotalCount > 0)
            {
                ViewData["PageParamName"] = "sessionPageNumber";
                <partial name="_Pagination" model="Model.Sessions" view-data="ViewData" />
            }
        </div>
    </div>
</div>

<!-- Modal: Bulk Revoke User Tokens -->
<div id="modal-revoke-user" class="modal-backdrop" onclick="closeModal('modal-revoke-user')">
    <div class="modal" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span>Bulk Revoke User Tokens</span>
            <button type="button" class="btn btn-secondary btn-sm" onclick="closeModal('modal-revoke-user')" style="padding: 0.2rem 0.45rem;">✕</button>
        </div>
        <form method="post" asp-page-handler="RevokeUserTokens" id="revoke-user-form">
            <div class="modal-body">
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.5;">
                    Revoke all active tokens (access tokens, refresh tokens, auth codes) issued for a specific user ID.
                </p>
                <div class="form-group">
                    <label class="form-label" for="revoke-user-input">User ID (Subject)</label>
                    <input type="text" name="targetUserId" id="revoke-user-input" class="form-control" placeholder="Enter User ID..." data-btn-target="revoke-user-btn" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('modal-revoke-user')">Cancel</button>
                <button type="button" id="revoke-user-btn" class="btn btn-danger" disabled onclick="openConfirmModal('Revoke User Tokens', 'Revoke ALL active tokens for user ' + document.getElementById('revoke-user-input').value + '?', () => document.getElementById('revoke-user-form').submit())">Revoke All</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Bulk Revoke Client Tokens -->
<div id="modal-revoke-client" class="modal-backdrop" onclick="closeModal('modal-revoke-client')">
    <div class="modal" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span>Bulk Revoke Client Tokens</span>
            <button type="button" class="btn btn-secondary btn-sm" onclick="closeModal('modal-revoke-client')" style="padding: 0.2rem 0.45rem;">✕</button>
        </div>
        <form method="post" asp-page-handler="RevokeClientTokens" id="revoke-client-form">
            <div class="modal-body">
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.5;">
                    Revoke all active tokens issued to a client application.
                </p>
                <div class="form-group">
                    <label class="form-label" for="revoke-client-input">Client ID</label>
                    <input type="text" name="targetClientId" id="revoke-client-input" class="form-control" placeholder="Enter Client ID..." data-btn-target="revoke-client-btn" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('modal-revoke-client')">Cancel</button>
                <button type="button" id="revoke-client-btn" class="btn btn-danger" disabled onclick="openConfirmModal('Revoke Client Tokens', 'Revoke ALL active tokens for client ' + document.getElementById('revoke-client-input').value + '?', () => document.getElementById('revoke-client-form').submit())">Revoke All</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal: Bulk Revoke User Sessions -->
<div id="modal-revoke-user-sessions" class="modal-backdrop" onclick="closeModal('modal-revoke-user-sessions')">
    <div class="modal" onclick="event.stopPropagation()">
        <div class="modal-header">
            <span>Revoke All User Sessions</span>
            <button type="button" class="btn btn-secondary btn-sm" onclick="closeModal('modal-revoke-user-sessions')" style="padding: 0.2rem 0.45rem;">✕</button>
        </div>
        <form method="post" asp-page-handler="RevokeUserSessions" id="revoke-user-sessions-form">
            <div class="modal-body">
                <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.5;">
                    Revoke all active authorization sessions and their tokens for a specified user ID.
                </p>
                <div class="form-group">
                    <label class="form-label" for="revoke-user-session-input">User ID (Subject)</label>
                    <input type="text" name="targetUserId" id="revoke-user-session-input" class="form-control" placeholder="Enter User ID..." data-btn-target="revoke-user-sessions-btn" required />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeModal('modal-revoke-user-sessions')">Cancel</button>
                <button type="button" id="revoke-user-sessions-btn" class="btn btn-danger" disabled onclick="openConfirmModal('Revoke User Sessions', 'Revoke ALL sessions and associated tokens for user ' + document.getElementById('revoke-user-session-input').value + '?', () => document.getElementById('revoke-user-sessions-form').submit())">Revoke Sessions</button>
            </div>
        </form>
    </div>
