@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        // Tab switching logic
        function switchInspectorTab(tabId) {
            const tokensBtn = document.getElementById('tab-btn-tokens');
            const sessionsBtn = document.getElementById('tab-btn-sessions');
            const tokensPanel = document.getElementById('tab-panel-tokens');
            const sessionsPanel = document.getElementById('tab-panel-sessions');

            if (tabId === 'sessions') {
                tokensBtn?.classList.remove('active');
                sessionsBtn?.classList.add('active');
                tokensPanel?.classList.remove('active');
                sessionsPanel?.classList.add('active');
            } else {
                sessionsBtn?.classList.remove('active');
                tokensBtn?.classList.add('active');
                sessionsPanel?.classList.remove('active');
                tokensPanel?.classList.add('active');
            }

            // Update URL query string without reloading page
            const url = new URL(window.location);
            url.searchParams.set('activeTab', tabId);
            window.history.replaceState({}, '', url);
        }

        // Collapsible filter helper
        function toggleFilterPanel(panelId, textId, chevronId) {
            const panel = document.getElementById(panelId);
            const text = document.getElementById(textId);
            const chevron = document.getElementById(chevronId);
            if (!panel) return;

            const isExpanded = panel.classList.toggle('expanded');
            if (text) text.textContent = isExpanded ? 'Hide Filters' : 'Show Filters';
            if (chevron) chevron.style.transform = isExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
        }

        // Charts logic
        (function() {
            const rawAppData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AppTokenCounts));
            const rawTimelineData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TokenTimeline));

            const palette = [
                '#6366f1', '#06b6d4', '#10b981', '#f59e0b', '#ec4899',
                '#8b5cf6', '#14b8a6', '#3b82f6', '#f97316', '#e11d48',
                '#84cc16', '#a855f7', '#0ea5e9', '#d946ef', '#64748b'
            ];

            let selectedClientId = null;
            let currentRangeDays = 30;

            const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
            const gridColor = isDark ? 'rgba(255, 255, 255, 0.06)' : 'rgba(0, 0, 0, 0.06)';
            const textColor = isDark ? '#94a3b8' : '#64748b';

            // 1. Applications Pie Chart
            const appLabels = rawAppData.map(a => a.DisplayName || a.ClientId || 'App');
            const appClientIds = rawAppData.map(a => a.ClientId);
            const appColors = rawAppData.map((_, i) => palette[i % palette.length]);
            const appValues = rawAppData.map(a => Math.max(1, a.TokenCount));

            const appsCtx = document.getElementById('tokensAppsChart');
            const appsChart = appsCtx ? new Chart(appsCtx, {
                type: 'pie',
                data: {
                    labels: appLabels,
                    datasets: [{
                        data: appValues,
                        backgroundColor: appColors,
                        borderColor: isDark ? '#1e293b' : '#ffffff',
                        borderWidth: 2,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                color: textColor,
                                boxWidth: 12,
                                padding: 10,
                                font: { size: 11, family: 'Inter' }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const app = rawAppData[context.dataIndex];
                                    return ` ${app.DisplayName || app.ClientId}: ${app.TokenCount} tokens`;
                                }
                            }
                        }
                    },
                    onClick: function(evt, elements) {
                        if (elements && elements.length > 0) {
                            const idx = elements[0].index;
                            const app = rawAppData[idx];
                            if (app && app.ClientId) {
                                filterByChartApp(app.ClientId);
                            }
                        }
                    }
                }
            }) : null;

            // 2. Tokens Doughnut Chart
            const tokenCounts = rawAppData.map(a => a.TokenCount);
            const tokensCtx = document.getElementById('tokensBreakdownChart');
            const tokensChart = tokensCtx ? new Chart(tokensCtx, {
                type: 'doughnut',
                data: {
                    labels: appLabels,
                    datasets: [{
                        data: tokenCounts.length > 0 ? tokenCounts : [0],
                        backgroundColor: appColors,
                        borderColor: isDark ? '#1e293b' : '#ffffff',
                        borderWidth: 2,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '62%',
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                color: textColor,
                                boxWidth: 12,
                                padding: 10,
                                font: { size: 11, family: 'Inter' }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const app = rawAppData[context.dataIndex];
                                    const total = tokenCounts.reduce((s, c) => s + c, 0);
                                    const pct = total > 0 ? Math.round((app.TokenCount / total) * 100) : 0;
                                    return ` ${app.DisplayName || app.ClientId}: ${app.TokenCount} tokens (${pct}%)`;
                                }
                            }
                        }
                    },
                    onClick: function(evt, elements) {
                        if (elements && elements.length > 0) {
                            const idx = elements[0].index;
                            const app = rawAppData[idx];
                            if (app && app.ClientId) {
                                filterByChartApp(app.ClientId);
                            }
                        }
                    }
                }
            }) : null;

            // 3. Timeline Line Chart
            const timelineCtx = document.getElementById('tokensTimelineChart');
            const timelineLabels = rawTimelineData.map(d => {
                const parts = d.Date.split('-');
                return parts.length === 3 ? `${parts[1]}/${parts[2]}` : d.Date;
            });
            const timelineValues = rawTimelineData.map(d => d.Count);

            const timelineChart = timelineCtx ? new Chart(timelineCtx, {
                type: 'line',
                data: {
                    labels: timelineLabels,
                    datasets: [{
                        label: 'Tokens Created',
                        data: timelineValues,
                        borderColor: '#6366f1',
                        backgroundColor: 'rgba(99, 102, 241, 0.15)',
                        fill: true,
                        tension: 0.35,
                        pointRadius: 3,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#6366f1',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                title: function(items) {
                                    return items[0]?.label || '';
                                },
                                label: function(item) {
                                    return ` Tokens Created: ${item.parsed.y}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: gridColor },
                            ticks: { color: textColor, font: { size: 10, family: 'Inter' } }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: gridColor },
                            ticks: {
                                color: textColor,
                                font: { size: 10, family: 'Inter' },
                                precision: 0
                            }
                        }
                    }
                }
            }) : null;

            function filterByChartApp(clientId) {
                const url = new URL(window.location.href);
                const currentFilter = url.searchParams.get('ClientId');
                if (currentFilter === clientId) {
                    url.searchParams.delete('ClientId');
                    url.searchParams.delete('SessionClientId');
                } else {
                    url.searchParams.set('ClientId', clientId);
                    url.searchParams.set('SessionClientId', clientId);
                }
                url.searchParams.delete('pageNumber');
                url.searchParams.delete('sessionPageNumber');
                window.location.href = url.toString();
            }

            // Highlight initial selected client if loaded from query string
            const initialFilteredClientId = '@(Model.ClientId ?? "")';
            if (initialFilteredClientId) {
                selectedClientId = initialFilteredClientId;
                const idx = appClientIds.indexOf(initialFilteredClientId);
                if (idx >= 0) {
                    const bgColors = appColors.map((c, i) => i === idx ? c : 'rgba(100, 116, 139, 0.2)');
                    if (appsChart) {
                        appsChart.data.datasets[0].backgroundColor = bgColors;
                        appsChart.update();
                    }
                    if (tokensChart) {
                        tokensChart.data.datasets[0].backgroundColor = bgColors;
                        tokensChart.update();
                    }
                }
            }

            window.onTokensTimelineRangeChange = function(days) {
                currentRangeDays = parseInt(days, 10) || 30;
                fetchTimelineData(selectedClientId, currentRangeDays);
            };

            function fetchTimelineData(clientId, days) {
                let url = '?handler=TokenTimeline&days=' + days;
                if (clientId) {
                    url += '&clientId=' + encodeURIComponent(clientId);
                }

                fetch(url)
                    .then(res => res.json())
                    .then(data => {
                        if (!timelineChart || !Array.isArray(data)) return;

                        const labels = data.map(d => {
                            const parts = d.date.split('-');
                            return parts.length === 3 ? `${parts[1]}/${parts[2]}` : d.date;
                        });
                        const values = data.map(d => d.count);

                        timelineChart.data.labels = labels;
                        timelineChart.data.datasets[0].data = values;
                        timelineChart.update();
                    })
                    .catch(err => console.error('Failed to fetch timeline data:', err));
            }
        })();

        // ===================================================
        // Token Multi-Selection & Cross-Page Persistence Logic
        // ===================================================
        const STORAGE_KEY_SELECTED_TOKENS = 'openiddict_selected_tokens_ids';
        const STORAGE_KEY_SELECTION_ACTIVE = 'openiddict_token_selection_mode';

        function getSelectedTokenIds() {
            try {
                const raw = sessionStorage.getItem(STORAGE_KEY_SELECTED_TOKENS);
                return raw ? JSON.parse(raw) : [];
            } catch {
                return [];
            }
        }

        function saveSelectedTokenIds(ids) {
            try {
                sessionStorage.setItem(STORAGE_KEY_SELECTED_TOKENS, JSON.stringify(ids));
            } catch (e) {
                console.error('Failed to save selected tokens to sessionStorage', e);
            }
        }

        function isTokenSelectionMode() {
            return sessionStorage.getItem(STORAGE_KEY_SELECTION_ACTIVE) === 'true';
        }

        function setTokenSelectionMode(isActive) {
            sessionStorage.setItem(STORAGE_KEY_SELECTION_ACTIVE, isActive ? 'true' : 'false');
            updateSelectionModeUI();
        }

        function toggleTokenSelectionMode() {
            setTokenSelectionMode(!isTokenSelectionMode());
        } 

        function exitTokenSelectionMode() {
            setTokenSelectionMode(false);
            clearTokenSelection();
        }

        function updateSelectionModeUI() {
            const isActive = isTokenSelectionMode();
            const bar = document.getElementById('token-selection-bar');
            const toggleBtn = document.getElementById('btn-toggle-select-mode');
            const toggleText = document.getElementById('btn-toggle-select-text');
            const selectCols = document.querySelectorAll('.token-select-col');

            selectCols.forEach(col => {
                col.style.display = isActive ? '' : 'none';
            });

            if (bar) {
                bar.classList.toggle('active', isActive);
            }

            if (toggleBtn) {
                toggleBtn.classList.toggle('btn-primary', isActive);
                toggleBtn.classList.toggle('btn-secondary', !isActive);
            }
            if (toggleText) {
                toggleText.textContent = isActive ? 'Selecting Tokens' : 'Select Tokens';
            }

            syncTokenCheckboxes();
        }

        function syncTokenCheckboxes() {
            const selectedIds = new Set(getSelectedTokenIds());
            const count = selectedIds.size;

            // Update counter badges and buttons
            const countBadge = document.getElementById('selection-counter-badge');
            if (countBadge) countBadge.textContent = count;

            const btnBadge = document.getElementById('btn-selected-badge');
            if (btnBadge) {
                btnBadge.textContent = count;
                btnBadge.style.display = count > 0 ? 'inline-block' : 'none';
            }

            const revokeBtnCount = document.getElementById('revoke-btn-count');
            if (revokeBtnCount) revokeBtnCount.textContent = count;

            const revokeBtn = document.getElementById('btn-revoke-selected');
            if (revokeBtn) revokeBtn.disabled = count === 0;

            // Sync row checkboxes on current page
            let allViewedChecked = true;
            let viewedCount = 0;
            const checkboxes = document.querySelectorAll('.token-row-checkbox');

            checkboxes.forEach(cb => {
                if (cb.disabled) return;
                viewedCount++;
                const id = cb.getAttribute('data-token-id');
                const isChecked = selectedIds.has(id);
                cb.checked = isChecked;
                if (!isChecked) allViewedChecked = false;
            });

            const headerCb = document.getElementById('select-all-viewed-checkbox');
            if (headerCb) {
                headerCb.checked = viewedCount > 0 && allViewedChecked;
            }
        }

        function onTokenRowCheckboxChange(cb) {
            const id = cb.getAttribute('data-token-id');
            if (!id) return;

            const selected = new Set(getSelectedTokenIds());
            if (cb.checked) {
                selected.add(id);
            } else {
                selected.delete(id);
            }
            saveSelectedTokenIds(Array.from(selected));
            syncTokenCheckboxes();
        }

        function toggleSelectViewedCheckbox(checked) {
            const selected = new Set(getSelectedTokenIds());
            const checkboxes = document.querySelectorAll('.token-row-checkbox');
            checkboxes.forEach(cb => {
                if (cb.disabled) return;
                cb.checked = checked;
                const id = cb.getAttribute('data-token-id');
                if (id) {
                    if (checked) selected.add(id);
                    else selected.delete(id);
                }
            });
            saveSelectedTokenIds(Array.from(selected));
            syncTokenCheckboxes();
        }

        function selectViewedTokens() {
            toggleSelectViewedCheckbox(true);
        }

        async function selectAllFilteredTokens() {
            const btn = document.getElementById('btn-select-all-filtered');
            const originalText = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = 'Fetching all...';
            }

            try {
                // Fetch unrevoked token IDs matching current filters via AJAX
                const url = new URL(window.location.href);
                url.searchParams.set('handler', 'AllTokenIds');
                const res = await fetch(url.toString());
                if (res.ok) {
                    const ids = await res.json();
                    if (Array.isArray(ids)) {
                        const current = new Set(getSelectedTokenIds());
                        ids.forEach(id => current.add(id));
                        saveSelectedTokenIds(Array.from(current));
                        syncTokenCheckboxes();
                    }
                }
            } catch (err) {
                console.error('Failed to fetch all matching token IDs:', err);
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            }
        }

        function clearTokenSelection() {
            saveSelectedTokenIds([]);
            syncTokenCheckboxes();
        }

        function confirmRevokeSelected() {
            const ids = getSelectedTokenIds();
            if (ids.length === 0) {
                alert('Please select at least one token to revoke.');
                return;
            }

            openConfirmModal(
                'Revoke Selected Tokens',
                `Are you sure you want to revoke ${ids.length} selected token(s) across all pages immediately?`,
                () => {
                    const form = document.getElementById('revoke-selected-tokens-form');
                    const container = document.getElementById('selected-tokens-inputs-container');
                    if (!form || !container) return;

                    container.innerHTML = '';
                    ids.forEach(id => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'selectedTokenIds';
                        input.value = id;
                        container.appendChild(input);
                    });

                    // Clear storage before submission
                    sessionStorage.removeItem(STORAGE_KEY_SELECTED_TOKENS);
                    sessionStorage.removeItem(STORAGE_KEY_SELECTION_ACTIVE);

                    form.submit();
                }
            );
        }

        // ============================================
        // Extend Token Expiration Modal
        // ============================================
        function openExtendTokenModal(tokenId, currentExpiry, isExpired) {
            const idInput = document.getElementById('extend-token-id-input');
            const displayId = document.getElementById('extend-token-display-id');
            const expiryDiv = document.getElementById('extend-token-current-expiry');
            const minutesInput = document.getElementById('extend-minutes-input');

            if (idInput) idInput.value = tokenId;
            if (displayId) displayId.textContent = tokenId;
            if (expiryDiv) {
                if (isExpired === true || isExpired === 'true') {
                    expiryDiv.innerHTML = `<span style="color: var(--warning-color, #f59e0b);">Expired (${currentExpiry}) - Extension starts from Now</span>`;
                } else {
                    expiryDiv.innerHTML = `<span style="color: var(--success-color, #10b981);">${currentExpiry}</span>`;
                }
            }
            if (minutesInput) minutesInput.value = 60;

            openModal('modal-extend-token');
        }

        // Initialize selection mode and restore checkboxes on page load
        document.addEventListener('DOMContentLoaded', () => {
            const selected = getSelectedTokenIds();
            if (isTokenSelectionMode() || selected.length > 0) {
                setTokenSelectionMode(true);
            }
        });
    </script>
}
