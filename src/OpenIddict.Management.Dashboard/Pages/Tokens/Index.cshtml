<!-- Slide-Over Drawer for Token Inspection -->
<div id="token-drawer-backdrop" class="modal-backdrop" onclick="closeTokenDrawer()"></div>
<div id="token-drawer" class="slide-over-drawer">
    <div class="slide-over-header">
        <h3 class="card-title" style="font-size: 1.1rem;">Token Inspection</h3>
        <button type="button" class="btn btn-secondary btn-sm" onclick="closeTokenDrawer()" style="padding: 0.25rem 0.5rem;">✕</button>
    </div>
    <div class="slide-over-body" id="token-drawer-body">
        <!-- Injected via JavaScript -->
    </div>
</div>

<!-- Slide-in Filter Properties Drawer for Tokens -->
<div id="tokens-filter-drawer-backdrop" class="filter-drawer-backdrop" onclick="closeFilterDrawer('tokens-filter-drawer')"></div>
<aside id="tokens-filter-drawer" class="filter-drawer" role="dialog" aria-modal="true" aria-labelledby="tokens-filter-drawer-title">
    <div class="filter-drawer-header">
        <div class="filter-drawer-title-group">
            <div class="filter-drawer-icon-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="6" x2="20" y2="6"></line>
                    <circle cx="8" cy="6" r="2.5" fill="currentColor"></circle>
                    <line x1="4" y1="12" x2="20" y2="12"></line>
                    <circle cx="16" cy="12" r="2.5" fill="currentColor"></circle>
                    <line x1="4" y1="18" x2="20" y2="18"></line>
                    <circle cx="10" cy="18" r="2.5" fill="currentColor"></circle>
                </svg>
            </div>
            <div>
                <h3 id="tokens-filter-drawer-title" class="filter-drawer-title">Filter Tokens</h3>
                <span class="filter-drawer-subtitle">Filter tokens by client, subject, status & date</span>
            </div>
        </div>
        <button type="button" class="filter-drawer-close" onclick="closeFilterDrawer('tokens-filter-drawer')" aria-label="Close filter drawer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <form method="get" id="token-filter-drawer-form" class="filter-drawer-form">
        <input type="hidden" name="activeTab" value="tokens" />
        <div class="filter-drawer-body">
            <div class="form-group">
                <label class="form-label" for="drawer-token-search">Search Keyword</label>
                <input type="text" id="drawer-token-search" name="SearchTerm" class="form-control" placeholder="Token ID, reference, user, or client..." value="@Model.SearchTerm" />
            </div>

            <div class="form-group">
                <label class="form-label" for="drawer-filter-client-id">Client ID</label>
                <input type="text" id="drawer-filter-client-id" name="ClientId" class="form-control" placeholder="Filter by Client ID..." value="@Model.ClientId" />
            </div>

            <div class="form-group">
                <label class="form-label" for="drawer-filter-user-id">User ID (Subject)</label>
                <input type="text" id="drawer-filter-user-id" name="UserId" class="form-control" placeholder="Filter by Subject..." value="@Model.UserId" />
            </div>

            <div class="form-group">
                <label class="form-label" for="drawer-filter-auth-id">Authorization ID</label>
                <input type="text" id="drawer-filter-auth-id" name="AuthorizationId" class="form-control" placeholder="Filter by Authorization ID..." value="@Model.AuthorizationId" />
            </div>

            <div class="form-group">
                <label class="form-label" for="drawer-filter-status">Status</label>
                <select id="drawer-filter-status" name="Status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="active" selected="@(string.Equals(Model.Status, "active", StringComparison.OrdinalIgnoreCase))">Active / Valid</option>
                    <option value="expired" selected="@(string.Equals(Model.Status, "expired", StringComparison.OrdinalIgnoreCase))">Expired</option>
                    <option value="revoked" selected="@(string.Equals(Model.Status, "revoked", StringComparison.OrdinalIgnoreCase))">Revoked</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label" for="drawer-filter-token-type">Token Type</label>
                <select id="drawer-filter-token-type" name="TokenType" class="form-select">
                    <option value="">All Types</option>
                    <option value="access_token" selected="@(Model.TokenType == "access_token")">Access Token</option>
                    <option value="refresh_token" selected="@(Model.TokenType == "refresh_token")">Refresh Token</option>
                    <option value="authorization_code" selected="@(Model.TokenType == "authorization_code")">Authorization Code</option>
                    <option value="device_code" selected="@(Model.TokenType == "device_code")">Device Code</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Creation Date Range</label>
                <div class="filter-grid-2">
                    <div>
                        <span class="filter-sublabel">From</span>
                        <input type="date" id="drawer-filter-created-from" name="CreatedFrom" class="form-control" value="@Model.CreatedFrom?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div>
                        <span class="filter-sublabel">To</span>
                        <input type="date" id="drawer-filter-created-to" name="CreatedTo" class="form-control" value="@Model.CreatedTo?.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
            </div>
        </div>

        <div class="filter-drawer-footer">
            <a href="@prefix/Tokens?activeTab=tokens" class="btn btn-secondary">Reset Filters</a>
            <button type="submit" class="btn btn-primary">Apply Filters</button>
        </div>
    </form>
</aside>

<!-- Slide-in Filter Properties Drawer for Sessions -->
<div id="sessions-filter-drawer-backdrop" class="filter-drawer-backdrop" onclick="closeFilterDrawer('sessions-filter-drawer')"></div>
<aside id="sessions-filter-drawer" class="filter-drawer" role="dialog" aria-modal="true" aria-labelledby="sessions-filter-drawer-title">
    <div class="filter-drawer-header">
        <div class="filter-drawer-title-group">
            <div class="filter-drawer-icon-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="4" y1="6" x2="20" y2="6"></line>
                    <circle cx="8" cy="6" r="2.5" fill="currentColor"></circle>
                    <line x1="4" y1="12" x2="20" y2="12"></line>
                    <circle cx="16" cy="12" r="2.5" fill="currentColor"></circle>
                    <line x1="4" y1="18" x2="20" y2="18"></line>
                    <circle cx="10" cy="18" r="2.5" fill="currentColor"></circle>
                </svg>
            </div>
            <div>
                <h3 id="sessions-filter-drawer-title" class="filter-drawer-title">Filter Sessions</h3>
                <span class="filter-drawer-subtitle">Search authorizations by subject & client</span>
            </div>
        </div>
        <button type="button" class="filter-drawer-close" onclick="closeFilterDrawer('sessions-filter-drawer')" aria-label="Close filter drawer">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <form method="get" id="session-filter-drawer-form" class="filter-drawer-form">
        <input type="hidden" name="activeTab" value="sessions" />
        <div class="filter-drawer-body">
            <div class="form-group">
                <label class="form-label" for="drawer-session-search">Search Keyword</label>
                <input type="text" id="drawer-session-search" name="SessionSearchTerm" class="form-control" placeholder="Auth ID, user, client, or scopes..." value="@Model.SessionSearchTerm" />
            </div>

            <div class="form-group">
                <label class="form-label" for="drawer-session-user-id">User ID (Subject)</label>
                <input type="text" id="drawer-session-user-id" name="SessionUserId" class="form-control" placeholder="Filter by User ID..." value="@Model.SessionUserId" />
            </div>

            <div class="form-group">
                <label class="form-label" for="drawer-session-client-id">Client ID</label>
                <input type="text" id="drawer-session-client-id" name="SessionClientId" class="form-control" placeholder="Filter by Client ID..." value="@Model.SessionClientId" />
            </div>

            <div class="form-group">
                <label class="form-label" for="drawer-session-status">Status</label>
                <select id="drawer-session-status" name="SessionStatus" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="active" selected="@(string.Equals(Model.SessionStatus, "active", StringComparison.OrdinalIgnoreCase))">Active / Valid</option>
                    <option value="revoked" selected="@(string.Equals(Model.SessionStatus, "revoked", StringComparison.OrdinalIgnoreCase))">Revoked</option>
                </select>
            </div>
        </div>

        <div class="filter-drawer-footer">
            <a href="@prefix/Tokens?activeTab=sessions" class="btn btn-secondary">Reset Filters</a>
            <button type="submit" class="btn btn-primary">Apply Filters</button>
        </div>
    </form>
</aside>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        // Tab switching logic
        function switchInspectorTab(tabId) {
            const tokensBtn = document.getElementById('tab-btn-tokens');
            const sessionsBtn = document.getElementById('tab-btn-sessions');
            const tokensPanel = document.getElementById('tab-panel-tokens');
            const sessionsPanel = document.getElementById('tab-panel-sessions');

            if (tabId === 'sessions') {
                tokensBtn?.classList.remove('active');
                sessionsBtn?.classList.add('active');
                tokensPanel?.classList.remove('active');
                sessionsPanel?.classList.add('active');
            } else {
                sessionsBtn?.classList.remove('active');
                tokensBtn?.classList.add('active');
                sessionsPanel?.classList.remove('active');
                tokensPanel?.classList.add('active');
            }

            // Update URL query string without reloading page
            const url = new URL(window.location);
            url.searchParams.set('activeTab', tabId);
            window.history.replaceState({}, '', url);
        }

        // Collapsible filter helper
        function toggleFilterPanel(panelId, textId, chevronId) {
            const panel = document.getElementById(panelId);
            const text = document.getElementById(textId);
            const chevron = document.getElementById(chevronId);
            if (!panel) return;

            const isExpanded = panel.classList.toggle('expanded');
            if (text) text.textContent = isExpanded ? 'Hide Filters' : 'Show Filters';
            if (chevron) chevron.style.transform = isExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
        }

        // Charts logic
        (function() {
            const rawAppData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AppTokenCounts));
            const rawTimelineData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TokenTimeline));

            const palette = [
                '#6366f1', '#06b6d4', '#10b981', '#f59e0b', '#ec4899',
                '#8b5cf6', '#14b8a6', '#3b82f6', '#f97316', '#e11d48',
                '#84cc16', '#a855f7', '#0ea5e9', '#d946ef', '#64748b'
            ];

            let selectedClientId = null;
            let currentRangeDays = 30;

            const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
            const gridColor = isDark ? 'rgba(255, 255, 255, 0.06)' : 'rgba(0, 0, 0, 0.06)';
            const textColor = isDark ? '#94a3b8' : '#64748b';

            // 1. Applications Pie Chart
            const appLabels = rawAppData.map(a => a.DisplayName || a.ClientId || 'App');
            const appClientIds = rawAppData.map(a => a.ClientId);
            const appColors = rawAppData.map((_, i) => palette[i % palette.length]);
            const appValues = rawAppData.map(a => Math.max(1, a.TokenCount));

            const appsCtx = document.getElementById('tokensAppsChart');
            const appsChart = appsCtx ? new Chart(appsCtx, {
                type: 'pie',
                data: {
                    labels: appLabels,
                    datasets: [{
                        data: appValues,
                        backgroundColor: appColors,
                        borderColor: isDark ? '#1e293b' : '#ffffff',
                        borderWidth: 2,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                color: textColor,
                                boxWidth: 12,
                                padding: 10,
                                font: { size: 11, family: 'Inter' }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const app = rawAppData[context.dataIndex];
                                    return ` ${app.DisplayName || app.ClientId}: ${app.TokenCount} tokens`;
                                }
                            }
                        }
                    },
                    onClick: function(evt, elements) {
                        if (elements && elements.length > 0) {
                            const idx = elements[0].index;
                            const app = rawAppData[idx];
                            if (selectedClientId === app.ClientId) {
                                resetTokenChartFilter();
                            } else {
                                applyTokenAppFilter(app.ClientId, app.DisplayName || app.ClientId);
                            }
                        }
                    }
                }
            }) : null;

            // 2. Tokens Doughnut Chart
            const tokenCounts = rawAppData.map(a => a.TokenCount);
            const tokensCtx = document.getElementById('tokensBreakdownChart');
            const tokensChart = tokensCtx ? new Chart(tokensCtx, {
                type: 'doughnut',
                data: {
                    labels: appLabels,
                    datasets: [{
                        data: tokenCounts.length > 0 ? tokenCounts : [0],
                        backgroundColor: appColors,
                        borderColor: isDark ? '#1e293b' : '#ffffff',
                        borderWidth: 2,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '62%',
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                color: textColor,
                                boxWidth: 12,
                                padding: 10,
                                font: { size: 11, family: 'Inter' }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const app = rawAppData[context.dataIndex];
                                    const total = tokenCounts.reduce((s, c) => s + c, 0);
                                    const pct = total > 0 ? Math.round((app.TokenCount / total) * 100) : 0;
                                    return ` ${app.DisplayName || app.ClientId}: ${app.TokenCount} tokens (${pct}%)`;
                                }
                            }
                        }
                    },
                    onClick: function(evt, elements) {
                        if (elements && elements.length > 0) {
                            const idx = elements[0].index;
                            const app = rawAppData[idx];
                            if (selectedClientId === app.ClientId) {
                                resetTokenChartFilter();
                            } else {
                                applyTokenAppFilter(app.ClientId, app.DisplayName || app.ClientId);
                            }
                        }
                    }
                }
            }) : null;

            // 3. Timeline Line Chart
            const timelineCtx = document.getElementById('tokensTimelineChart');
            const timelineLabels = rawTimelineData.map(d => {
                const parts = d.Date.split('-');
                return parts.length === 3 ? `${parts[1]}/${parts[2]}` : d.Date;
            });
            const timelineValues = rawTimelineData.map(d => d.Count);

            const timelineChart = timelineCtx ? new Chart(timelineCtx, {
                type: 'line',
                data: {
                    labels: timelineLabels,
                    datasets: [{
                        label: 'Tokens Created',
                        data: timelineValues,
                        borderColor: '#6366f1',
                        backgroundColor: 'rgba(99, 102, 241, 0.15)',
                        fill: true,
                        tension: 0.35,
                        pointRadius: 3,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#6366f1',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                title: function(items) {
                                    return items[0]?.label || '';
                                },
                                label: function(item) {
                                    return ` Tokens Created: ${item.parsed.y}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: gridColor },
                            ticks: { color: textColor, font: { size: 10, family: 'Inter' } }
                        },
                        y: {
                            beginAtZero: true,
                            grid: { color: gridColor },
                            ticks: {
                                color: textColor,
                                font: { size: 10, family: 'Inter' },
                                precision: 0
                            }
                        }
                    }
                }
            }) : null;

            window.applyTokenAppFilter = function(clientId, appName) {
                selectedClientId = clientId;

                const idx = appClientIds.indexOf(clientId);
                if (idx >= 0) {
                    const bgColors = appColors.map((c, i) => i === idx ? c : 'rgba(100, 116, 139, 0.2)');
                    if (appsChart) {
                        appsChart.data.datasets[0].backgroundColor = bgColors;
                        appsChart.update();
                    }
                    if (tokensChart) {
                        tokensChart.data.datasets[0].backgroundColor = bgColors;
                        tokensChart.update();
                    }
                }

                // Pre-fill filter inputs if present
                const filterClientId = document.getElementById('filter-client-id');
                if (filterClientId && !filterClientId.value) {
                    filterClientId.value = clientId;
                }
                const sessionClientId = document.getElementById('session-client-id');
                if (sessionClientId && !sessionClientId.value) {
                    sessionClientId.value = clientId;
                }

                fetchTimelineData(clientId, currentRangeDays);
            };

            window.resetTokenChartFilter = function() {
                selectedClientId = null;

                if (appsChart) {
                    appsChart.data.datasets[0].backgroundColor = [...appColors];
                    appsChart.update();
                }
                if (tokensChart) {
                    tokensChart.data.datasets[0].backgroundColor = [...appColors];
                    tokensChart.update();
                }

                fetchTimelineData(null, currentRangeDays);
            };

            window.onTokensTimelineRangeChange = function(days) {
                currentRangeDays = parseInt(days, 10) || 30;
                fetchTimelineData(selectedClientId, currentRangeDays);
            };

            function fetchTimelineData(clientId, days) {
                let url = '?handler=TokenTimeline&days=' + days;
                if (clientId) {
                    url += '&clientId=' + encodeURIComponent(clientId);
                }

                fetch(url)
                    .then(res => res.json())
                    .then(data => {
                        if (!timelineChart || !Array.isArray(data)) return;

                        const labels = data.map(d => {
                            const parts = d.date.split('-');
                            return parts.length === 3 ? `${parts[1]}/${parts[2]}` : d.date;
                        });
                        const values = data.map(d => d.count);

                        timelineChart.data.labels = labels;
                        timelineChart.data.datasets[0].data = values;
                        timelineChart.update();
                    })
                    .catch(err => console.error('Failed to fetch timeline data:', err));
            }
        })();
    </script>
}
