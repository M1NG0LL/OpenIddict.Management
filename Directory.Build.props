<Project>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and $(MSBuildProjectName.EndsWith('.Tests'))">
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks />
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' and $(MSBuildProjectName.StartsWith('Sample.'))">
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks />
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Package Versioning -->
    <VersionPrefix>1.2.0</VersionPrefix>
    <VersionSuffix Condition="'$(Configuration)' != 'Release'">preview.1</VersionSuffix>

    <!-- Package Metadata -->
    <Authors>M1NG0LL, Ahmed Fathy</Authors>
    <Company>M1NG0LL</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/M1NG0LL/OpenIddict.Management</PackageProjectUrl>
    <RepositoryUrl>https://github.com/M1NG0LL/OpenIddict.Management.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 M1NG0LL</Copyright>
    <PackageTags>openiddict;identity;oauth2;oidc;security;admin;dashboard;aspnetcore</PackageTags>

    <!-- Source Link & Debugging Symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Include package-specific README if it exists, otherwise fallback to root README -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Condition="Exists('README.md')" Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Condition="!Exists('README.md')" Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
